#include "screen.c"

#ifdef IS_CWRITER
	struct sceMcTblGetDir___Create {
		unsigned char Resv2;
		unsigned char Sec;
		unsigned char Min;
		unsigned char Hour;
		unsigned char Day;
		unsigned char Month;
		short unsigned int Year;
	};

	struct sceMcTblGetDir___Modify {
		unsigned char Resv2;
		unsigned char Sec;
		unsigned char Min;
		unsigned char Hour;
		unsigned char Day;
		unsigned char Month;
		short unsigned int Year;
	};

	typedef struct {
		struct sceMcTblGetDir___Create _Create;
		struct sceMcTblGetDir___Modify _Modify;
		unsigned int FileSizeByte;
		short unsigned int AttrFile;
		short unsigned int Reserve1;
		unsigned int Reserve2;
		unsigned int PdaAplNo;
		unsigned char EntryName[32];
	} sceMcTblGetDir;

	extern void cd_card(int port, int slot, char *fname);
    extern void read_card(int port, int slot, char *fname, int startpos, int size, void *buf);
	extern void dir_card(int port, int slot, char *fname, unsigned int mode, int maxentry, sceMcTblGetDir *dirbuff);
	extern void check_card(int port, int slot);

    extern int sceMcSync(int mode, int *cmds, int *result);

	extern int Port;
	extern int Slot;

	// extern unsigned char usbd_irx[];
    // extern unsigned int usbd_irx_len;

    // extern unsigned char usbhdfsd_irx[];
    // extern unsigned int usbhdfsd_irx_len;

	extern unsigned int _sceSifLoadModuleBuffer(void *ptr, int size, const char *args, int *mod_res);

	void wait_for_mc() {
		int cmd, result;
        while (sceMcSync(1, &cmd, &result) != 1) {
            for(volatile int i = 0; i < 500; i++);
        }
	}
#endif

void init() {

	// printf("reading %s\n", file);

	ShowLoad();

	#ifdef IS_CWRITER

		// int mod_res;
		// _sceSifLoadModuleBuffer(usbd_irx, usbd_irx_len, NULL, &mod_res);
		// int mod_res2;
    	// _sceSifLoadModuleBuffer(usbhdfsd_irx, usbhdfsd_irx_len, NULL, &mod_res2);

		sceMcTblGetDir mc_entry;
		int res;
		int num_found;
		int t;

		printf("port/slot %d %d\n", Port, Slot);

		char* folder = "BASLUS-20224";
		char* file = "BASLUS-20224";

		check_card(Port, Slot);
		wait_for_mc();

		cd_card(Port, Slot, folder);
		wait_for_mc();

		dir_card(Port, Slot, file, 32, 2, &mc_entry);
		wait_for_mc();

		printf("num_found %d\n", num_found);

		int size = 1000; // mc_entry.FileSizeByte;

		printf("FileSizeByte %d\n", mc_entry.FileSizeByte);

		read_card(Port, Slot, file, 0, 0x92e8, (void*)0x01F00000);
		wait_for_mc();

		// if (num_found == 0) {
		// 	ShowReadError();
		// 	return;
		// }

		FlushCache(0);
		FlushCache(2);

		while (1) {

		}

		RunMod(1);
	#endif

	#ifndef IS_CWRITER
		char* file = "host:mod.bin";
		
		int fd = sceOpen(file, 00);

		if (fd >= 0) {

			int size = sceLseek(fd, 0, 2);
			sceLseek(fd, 0, 0);

			sceRead(fd, (void*)0x01F00000, size);
			sceClose(fd);

			printf("read %d bytes from %s\n", size, file);

			while (1) {

			}
			
			// invalidate EE/data cache
			FlushCache(0);
			FlushCache(2);

			// printf("executing\n");
			#ifdef IS_CWRITER
				RunMod(1);
			#endif
			
			#ifndef IS_CWRITER
				RunMod(0);
			#endif

			// printf("running game\n");
		}
		else {
			ShowReadError();
		}
	#endif
}